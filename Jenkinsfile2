pipeline {
    agent any

    environment {
        ENV_SETUP_REPO = "github.com/MayElbaz18/koreflow-environmentsetup.git"
        ENV_REPO_DIR = "/var/jenkins_home/koreflow-environmentSetup"
        SERVICE_DEPLOY_REPO = "github.com/MayElbaz18/koreflow.git"
        SERVICE_DEPLOY_REPO_DIR = "koreflow-servicesdeployment"
        BRANCH = 'main'
        GITHUB_CREDENTIALS = credentials('github-credentials')
        DOCKER_CREDS = 'dockerhub-credentials'
    }

    stages {

        stage('Clone Environment Setup Repo') {
            steps {
                script {
                    def gitAuthEnvRepo = "https://${env.GITHUB_CREDENTIALS_USR}:${env.GITHUB_CREDENTIALS_PSW}@${env.ENV_SETUP_REPO}"
                    sh """
                        if [ -d "${env.ENV_REPO_DIR}" ]; then
                            cd ${env.ENV_REPO_DIR}
                            echo "[INFO] Pulling updates for environment setup repository..."
                            git pull ${gitAuthEnvRepo}
                        else
                            echo "[INFO] Cloning Environment Setup repository (branch ${env.BRANCH})..."
                            git clone ${gitAuthEnvRepo} ${env.ENV_REPO_DIR}
                        fi
                    """
                }
            }
        }

        stage('Clone or Pull Services Deployment Repo') {
            steps {
                script {
                    def gitAuthServiceRepo = "https://${env.GITHUB_CREDENTIALS_USR}:${env.GITHUB_CREDENTIALS_PSW}@${env.SERVICE_DEPLOY_REPO}"
                    sh """
                        if [ -d "${env.SERVICE_DEPLOY_REPO_DIR}" ]; then
                            cd ${env.SERVICE_DEPLOY_REPO_DIR}
                            echo "[INFO] Pulling updates for services deployment repository..."
                            git fetch --all
                            git checkout ${env.BRANCH}
                            git pull ${gitAuthServiceRepo} ${env.BRANCH}
                        else
                            echo "[INFO] Cloning services deployment repository (branch ${env.BRANCH})..."
                            git clone --branch ${env.BRANCH} ${gitAuthServiceRepo} ${env.SERVICE_DEPLOY_REPO_DIR}
                        fi
                    """
                }
            }
        }

        stage('Docker Login and Configure Registry Secret') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKER_CREDS,
                    usernameVariable: 'DOCKER_USER_FOR_DOCKER_BUILD',
                    passwordVariable: 'DOCKER_PASS_FOR_DOCKER_BUILD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS_FOR_DOCKER_BUILD" | docker login \
                            --username "$DOCKER_USER_FOR_DOCKER_BUILD" \
                            --password-stdin
                    '''

                    script {
                        def kubeconfigPath = "${env.ENV_REPO_DIR}/kubeconfig"
                        sh """
                            KUBECONFIG=${kubeconfigPath} kubectl delete secret dockerhub --insecure-skip-tls-verify=true || true

                            KUBECONFIG=${kubeconfigPath} kubectl create secret docker-registry dockerhub \
                                --docker-username="$DOCKER_USER_FOR_DOCKER_BUILD" \
                                --docker-password="$DOCKER_PASS_FOR_DOCKER_BUILD" \
                                --docker-server=https://index.docker.io/v1/ \
                                --insecure-skip-tls-verify=true
                        """
                    }
                }
            }
        }

        stage('Deploy Services') {
            steps {
                script {
                    def kubeconfigPath = "${env.ENV_REPO_DIR}/kubeconfig"
                    def helmReleaseName = "koreflow"

                    withEnv(["KUBECONFIG=${kubeconfigPath}"]) {
                        try {
                            dir("${env.SERVICE_DEPLOY_REPO_DIR}/KoreFlow-prod") {
                                echo "[INFO] 🚀 Starting Helm deployment..."
                                sh """
                                    helm upgrade --install ${helmReleaseName} ./charts/koreflow \
                                        --wait \
                                        --timeout 120s
                                """
                                echo "[INFO] ✅ Helm deployment succeeded."
                                sh "helm status ${helmReleaseName}"
                            }
                        } catch (e) {
                            echo "[ERROR] ❌ Helm deployment failed. Attempting rollback..."
                            sh """
                                if helm history ${helmReleaseName} --max=1 > /dev/null 2>&1; then
                                    helm rollback ${helmReleaseName} || echo '[WARN] Rollback failed.'
                                else
                                    echo '[INFO] No previous release found. Skipping rollback.'
                                fi
                            """
                            throw e
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "[CLEANUP] Cleaning up workspace..."
            cleanWs(deleteDirs: true)
        }
    }
}
